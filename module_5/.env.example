# ==============================================================================
# Module 5 - Environment Configuration Template (.env.example)
# Johns Hopkins University - Software Concepts (EN.605.601)
# ==============================================================================
# Copy this file to '.env' and populate with your local database credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradcafe_db
DB_USER=gradcafe_app_user
DB_PASSWORD=your_secure_password_here

# Full Database URI (used by SQLAlchemy and psycopg)
DATABASE_URL=postgresql://gradcafe_app_user:your_secure_password_here@localhost:5432/gradcafe_db

# Web Application Server Settings
PORT=8080
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace_with_a_secure_random_hex_string
