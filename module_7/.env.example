# AWS Region Settings
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# S3 Data Pipeline Configuration
S3_BUCKET_NAME=grad-cafe-nf
S3_OBJECT_KEY=applicant_data.json
LOCAL_OUTPUT_PATH=applicant_data_SM.json

# Optional: EC2 Public IPv4 Address (for deployment verification)
EC2_PUBLIC_IPV4=54.210.88.142
EC2_PORT=8080

# Microservice Database Credentials for EC2 Deployment
POSTGRES_DB=gradcafe_db
POSTGRES_USER=gradcafe_user
POSTGRES_PASSWORD=gradcafe_secure_pass_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RabbitMQ Credentials for EC2 Deployment
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
