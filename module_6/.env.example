# PostgreSQL Configuration
POSTGRES_DB=gradcafe_db
POSTGRES_USER=gradcafe_user
POSTGRES_PASSWORD=gradcafe_secure_pass_2026
DATABASE_URL=postgresql://gradcafe_user:gradcafe_secure_pass_2026@db:5432/gradcafe_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2f

# Flask Web Service Configuration
PORT=8080
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=gradcafe_super_secret_microservice_key_2026
